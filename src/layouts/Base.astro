---
import { Font } from "astro:assets";
import { aloharmony, personal } from "../data/cv";

interface Props {
  title?: string;
  description?: string;
  pageType?: "ProfilePage" | "WebPage";
  ogType?: "website" | "profile" | "article";
}
const {
  title = "Daniel Suarez — CTO & Sr. Software Engineer | AI-directed engineering",
  description = "Daniel Suarez, CTO / Sr. Software Engineer at Aloharmony (~52k total users, ~5k DAU; iOS, Android, web), remote from Argentina. Knows what to ask AI and how: broad full-stack knowledge directing a governed team of AI agents.",
  pageType = "WebPage",
  ogType = "website",
} = Astro.props;

const site = personal.siteUrl;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/"), site).href;
const ogImage = new URL("/og-image.png", site).href;

const personId = `${site}/#person`;
const websiteId = `${site}/#website`;

const graph: any[] = [
  {
    "@type": "Person",
    "@id": personId,
    name: personal.name,
    url: site,
    email: `mailto:${personal.email}`,
    image: ogImage,
    jobTitle: personal.jobTitle,
    description: personal.summary,
    address: { "@type": "PostalAddress", addressLocality: "Buenos Aires", addressCountry: "AR" },
    homeLocation: { "@type": "Place", name: "Argentina" },
    worksFor: [
      { "@type": "Organization", name: "Aloharmony", url: aloharmony.url },
    ],
    founder: {
      "@type": "Organization",
      name: "Desition Labs",
      alternateName: "DesitionDev",
      url: "https://desitiondev.com",
    },
    knowsAbout: [
      "AI-assisted software engineering",
      "AI agent orchestration",
      "React", "Next.js", "Astro", "React Native", "Expo",
      "Node.js", "NestJS", "GraphQL", "REST APIs",
      "AWS", "Docker", "Redis", "Kafka", "Metabase",
      "RevenueCat", "Stripe", "OpenAI", "Anthropic", "Grok", "Google Gemini", "Nano Banana", "Veo", "SEO", "Generative Engine Optimization",
    ],
    knowsLanguage: ["es", "en"],
    sameAs: ["https://desitiondev.com", personal.github, personal.linkedin],
  },
  {
    "@type": "WebSite",
    "@id": websiteId,
    url: site,
    name: "Daniel Suarez",
    inLanguage: "en",
    publisher: { "@id": personId },
  },
  {
    "@type": pageType,
    "@id": `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    inLanguage: "en",
    isPartOf: { "@id": websiteId },
    ...(pageType === "ProfilePage" ? { mainEntity: { "@id": personId } } : { about: { "@id": personId } }),
  },
];

if (pageType === "ProfilePage") {
  graph.push({
    "@type": "SoftwareApplication",
    "@id": `${site}/#aloharmony`,
    name: aloharmony.name,
    url: aloharmony.url,
    description: aloharmony.description,
    applicationCategory: "HealthApplication",
    operatingSystem: "iOS, Android, Web",
    creator: { "@type": "Organization", name: "Aloharmony" },
    contributor: { "@id": personId },
  });
}

const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={personal.name} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#f7f5f0" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Daniel Suarez" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Daniel Suarez — CTO & Sr. Software Engineer" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Daniel Suarez — CTO & Sr. Software Engineer" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-mono" preload />
  </head>
  <body class="bg-canvas text-ink font-sans antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:bg-ink focus:text-canvas focus:px-3 focus:py-2 focus:rounded">Skip to content</a>
    <slot />
    <script>
      const observer = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && e.target.classList.add("visible")),
        { threshold: 0.08 }
      );
      document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
    </script>
  </body>
</html>

