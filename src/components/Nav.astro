---
import { personal } from "../data/cv";

const links = [
  { href: "/", label: "Home" },
  { href: "/#impact", label: "Impact" },
  { href: "/#ai-method", label: "AI method" },
  { href: "/#work", label: "Work" },
  { href: "/#experience", label: "Experience" },
  { href: "/blog", label: "Blog" },
  { href: "/#faq", label: "FAQ" },
  { href: "/#contact", label: "Contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-canvas/90 backdrop-blur-sm border-b border-border">
  <div class="max-w-5xl mx-auto px-6 h-14 flex items-center justify-between">

    <a href="/" class="font-display font-semibold text-base text-ink tracking-tight no-underline">
      Daniel Suarez
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Main">
      {links.map(l => (
        <a
          href={l.href}
          class={`px-3 py-1.5 rounded-md text-sm font-medium transition-colors duration-150 no-underline
            ${currentPath === l.href
              ? 'bg-surface2 text-ink'
              : 'text-muted hover:text-ink hover:bg-surface2'
            }`}
        >
          {l.label}
        </a>
      ))}
      <a
        href={personal.desitiondev}
        target="_blank"
        rel="me noopener noreferrer"
        class="px-3 py-1.5 rounded-md text-sm font-medium text-muted hover:text-ink hover:bg-surface2 transition-colors duration-150 no-underline"
      >
        DesitionDev
      </a>
    </nav>

    <a
      href={`mailto:${personal.email}`}
      class="hidden lg:inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-accent text-white text-sm font-semibold no-underline hover:bg-accent2 transition-colors duration-150"
    >
      Get in touch
    </a>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="lg:hidden p-2 rounded-md text-muted hover:text-ink hover:bg-surface2 transition-colors"
      aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu"
    >
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>

  <!-- Mobile dropdown -->
  <nav id="mobile-menu" aria-label="Mobile" class="hidden lg:hidden border-t border-border bg-canvas px-6 py-4 flex flex-col gap-1">
    {links.map(l => (
      <a href={l.href} class="px-3 py-2 rounded-md text-sm font-medium text-muted hover:text-ink hover:bg-surface2 no-underline transition-colors">
        {l.label}
      </a>
    ))}
    <a
      href={personal.desitiondev}
      target="_blank"
      rel="me noopener noreferrer"
      class="px-3 py-2 rounded-md text-sm font-medium text-muted hover:text-ink hover:bg-surface2 no-underline transition-colors"
    >
      DesitionDev
    </a>
    <a href={`mailto:${personal.email}`} class="mt-2 px-3 py-2 rounded-md text-sm font-semibold text-accent no-underline">
      Get in touch →
    </a>
  </nav>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    const hidden = menu?.classList.toggle("hidden");
    btn.setAttribute("aria-expanded", String(!hidden));
  });
</script>
