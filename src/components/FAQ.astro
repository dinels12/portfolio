---
import { faq } from "../data/cv";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<section id="faq" class="py-24 bg-canvas border-t border-border" aria-labelledby="faq-title">
  <div class="max-w-3xl mx-auto px-6">
    <p class="font-mono text-xs text-accent uppercase tracking-widest mb-2">FAQ</p>
    <h2 id="faq-title" class="font-display text-4xl font-bold tracking-tight text-ink mb-10">Frequently asked questions</h2>
    <div class="flex flex-col gap-3">
      {faq.map((f) => (
        <details class="group bg-surface border border-border rounded-xl p-5 open:shadow-sm">
          <summary class="cursor-pointer list-none flex justify-between gap-4 font-semibold text-base text-ink">
            <h3 class="font-semibold text-base">{f.q}</h3>
            <span class="text-accent transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="text-sm text-ink2 leading-relaxed mt-3">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</section>
