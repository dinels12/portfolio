---
import { personal } from "../data/cv";
---

<section class="pt-32 pb-24">
  <div class="max-w-5xl mx-auto px-6">
    <div class="max-w-3xl">
      <!-- Status pill -->
      <div
        class="inline-flex items-center gap-2 bg-tag-bg border border-blue-200 text-tag-text text-xs font-semibold px-3 py-1.5 rounded-full mb-8 font-mono tracking-wide"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse" aria-hidden="true"></span>
        Open for consulting
      </div>

      <!-- Headline -->
      <h1 class="font-display text-5xl sm:text-6xl font-bold leading-tight tracking-tight text-ink mb-6">
        Hi, I'm Daniel —<br />
        <span class="italic font-normal text-muted">CTO &amp; Sr. Software Engineer.</span>
      </h1>

      <!-- Description -->
      <p class="text-lg text-ink2 leading-relaxed mb-5 max-w-xl">
        I lead technology at <strong class="text-ink font-semibold">Aloharmony</strong>, a wellness app with
        therapeutic music with <strong class="text-ink font-semibold">~52k total users</strong> and ~5k daily active users on iOS, Android and web.
        Based in <strong class="text-ink font-semibold">Buenos Aires</strong>, working remotely; 6 years shipping products across the full
        stack — mobile, web, backend, data, payments and cloud.
      </p>

      <!-- Core message -->
      <p class="text-lg text-ink2 leading-relaxed mb-6 max-w-xl border-l-2 border-accent pl-4">
        My edge is knowing <strong class="text-ink font-semibold">what to ask AI — and how</strong>. Broad, hands-on
        knowledge lets me direct a governed team of AI agents with real engineering judgment, and turn it into results.
      </p>

      <!-- Studio blurb (entity + first-party link to product hub) -->
      <p class="text-base text-ink2 leading-relaxed mb-10 max-w-xl">
        I also build my own products under
        <a
          href={personal.desitiondev}
          target="_blank"
          rel="me noopener noreferrer"
          class="text-ink font-semibold no-underline hover:text-accent transition-colors"
        >DesitionDev</a
        >
        — the public home of apps from DesitionLabs.
        <a
          href={personal.desitiondev}
          target="_blank"
          rel="me noopener noreferrer"
          class="inline-flex items-center gap-1 text-accent font-medium no-underline hover:text-accent2 transition-colors ml-1"
        >
          desitiondev.com
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
            ><path d="M5 12h14M12 5l7 7-7 7"></path></svg
          >
        </a>
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-3 mb-16">
        <a
          href="/#impact"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-ink text-canvas rounded-lg text-sm font-semibold no-underline hover:bg-ink2 transition-colors duration-150"
        >
          See my impact
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
            ><path d="M5 12h14M12 5l7 7-7 7"></path></svg
          >
        </a>
        <a
          href={`mailto:${personal.email}`}
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-surface border border-border rounded-lg text-sm font-semibold text-ink no-underline hover:border-border2 transition-colors duration-150"
        >
          Get in touch
        </a>
      </div>

      <!-- Quick stats -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-x-8 gap-y-6 pt-8 border-t border-border">
        <div>
          <div class="font-display text-3xl font-bold text-ink">6</div>
          <div class="text-xs text-muted font-medium uppercase tracking-wider mt-0.5">Years experience</div>
        </div>
        <div>
          <div class="font-display text-3xl font-bold text-ink">~52k</div>
          <div class="text-xs text-muted font-medium uppercase tracking-wider mt-0.5">Total users</div>
        </div>
        <div>
          <div class="font-display text-3xl font-bold text-ink">3</div>
          <div class="text-xs text-muted font-medium uppercase tracking-wider mt-0.5">Platforms: iOS · Android · Web</div>
        </div>
        <div>
          <div class="font-display text-3xl font-bold text-ink">~10</div>
          <div class="text-xs text-muted font-medium uppercase tracking-wider mt-0.5">AI agents, 24/7</div>
        </div>
      </div>
    </div>
  </div>
</section>
